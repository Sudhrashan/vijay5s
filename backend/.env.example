# ENV=production refuses to start while JWT_SECRET is a default/short value or ADMIN_PASSWORD is admin123.
ENV=development
# postgres:// and postgresql:// URLs (e.g. from Railway) are rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql+psycopg://vijay:vijay@localhost:5432/vijay5s
# REDIS_URL=redis://localhost:6379/0      # set when running more than one API instance
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
# Photo storage: leave SUPABASE_URL unset to save photos to UPLOAD_DIR (local dev / offline).
# Set both to upload issue/audit photos to Supabase Storage instead (recommended once deployed,
# since most hosts wipe local disk on redeploy).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service role secret key - never the anon/public key>
# SUPABASE_BUCKET=5sphotos
SEED_ON_START=true                        # set false in production after first run
# true: an empty database gets fake demo data (22 users, 11 zones, 6 months of audits/issues).
# false: only the Super Admin (ADMIN_EMP_ID / ADMIN_PASSWORD) is created -- use false for the real pilot,
# then add zones and users from the Zones and Users pages.
SEED_DEMO_DATA=true
ADMIN_EMP_ID=EMP1001
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=vijay123
