# Rendered by the nginx image at start-up: ${PORT} and ${API_UPSTREAM} come from env vars.
# API_UPSTREAM = host:port of the FastAPI service (Railway: api.railway.internal:8000).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  client_max_body_size 15m;   # phone photos

  # Variable upstream => resolved per request via the resolver in 00-resolver.conf
  set $api_upstream http://${API_UPSTREAM};

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_read_timeout 120s;
  }

  location /uploads/ {
    proxy_pass $api_upstream;
  }

  location = /ws {
    proxy_pass $api_upstream;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Hashed build assets can be cached forever; index.html must not be.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback so React Router routes (e.g. /audit/12) survive a refresh.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
