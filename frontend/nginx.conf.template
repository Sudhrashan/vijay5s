# Rendered by the nginx image at start-up: ${PORT}, ${API_UPSTREAM}, ${API_HOST} and
# ${API_SCHEME} come from env vars.
# API_UPSTREAM = host:port of the FastAPI service, used in the proxy_pass target.
#   - Railway: api.railway.internal:8000 (private network, plain HTTP)
#   - Render:  vijay5s-api.onrender.com:443 (no private network between free web services;
#     nginx proxies to the api service's public HTTPS hostname instead - see API_SCHEME below)
# API_HOST   = just the hostname part of API_UPSTREAM (no port), sent as the upstream Host
#   header so TLS SNI / virtual-host routing on the api side works.
# API_SCHEME = "http" (Railway private network) or "https" (Render / any public HTTPS upstream).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  client_max_body_size 15m;   # phone photos

  # Variable upstream => resolved per request via the resolver in 00-resolver.conf
  set $api_upstream ${API_SCHEME}://${API_UPSTREAM};

  proxy_http_version 1.1;
  # Upstream Host must be the API's OWN hostname when proxying to a public HTTPS hostname
  # (Render) so TLS SNI / virtual-host routing on the api side works; on Railway's private
  # network this is harmless too since the api service doesn't route on Host.
  proxy_set_header Host ${API_HOST};
  proxy_ssl_server_name on;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_connect_timeout 75s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    # Free-tier upstream can be mid-wake or briefly reset; retry once rather than
    # surfacing a bare 500 for a connection-level hiccup.
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
  }

  location /uploads/ {
    proxy_pass $api_upstream;
    proxy_connect_timeout 75s;
  }

  location = /ws {
    proxy_pass $api_upstream;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Hashed build assets can be cached forever; index.html must not be.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback so React Router routes (e.g. /audit/12) survive a refresh.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
